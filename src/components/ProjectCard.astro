---
/**
 * A single project in the work grid.
 *
 * Two deliberate departures from the old card:
 *
 * 1. Title, category and tools are ALWAYS visible in a caption block under the
 *    media. The old design hid them inside a hover overlay, which meant touch
 *    users never saw them and sighted users had to hunt.
 * 2. The data the modal needs is carried in `data-*` attributes rather than
 *    scraped out of the visible DOM, so the modal never depends on the card's
 *    markup staying the same shape.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../utils/url';
import { site, categoryLabel } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, category, description, tools, media, links } = project.data;

const href = withBase(`work/${project.id}/`);

const hasVideo = media.some((m) => m.type === 'video');
const isGallery = media.length > 1;
const first = media[0]!;

// Every card occupies the same grid cell, so one candidate set covers them all.
const imageWidths = [420, 700, 1000];
const imageSizes = '(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 31vw';

const badge = hasVideo
  ? { icon: 'play', text: 'Video' }
  : isGallery
    ? { icon: 'images', text: `${media.length} images` }
    : { icon: 'image', text: 'Still' };

const label = categoryLabel[category] ?? category;

/**
 * Alt text when a project's YAML doesn't supply its own.
 *
 * The old fallback was "<title> — image 3 of 8", which describes nothing and
 * is what Google Images had to work with for every one of these. Leading with
 * the subject and discipline at least puts the meaningful words first; the
 * counter is demoted to a disambiguator. Real per-image alt in the YAML still
 * beats this and should replace it.
 */
const altFor = (index: number) =>
  isGallery
    ? `${title} — ${label.toLowerCase()} by ${site.name} (${index + 1}/${media.length})`
    : `${title} — ${label.toLowerCase()} by ${site.name}`;
---

<article
  class="project-card reveal"
  id={project.id}
  data-category={category}
  data-title={title}
  data-description={description}
  data-tools={tools.join(', ')}
  data-category-label={label}
  data-links={JSON.stringify(links)}
  data-href={href}
>
  <div class="card-media">
    {
      isGallery ? (
        <div class="slideshow" data-slideshow>
          {media.map((m, i) => (
            <div class:list={['slide', { 'is-active': i === 0 }]}>
              {m.type === 'image' ? (
                <Image
                  src={m.src}
                  alt={m.alt ?? altFor(i)}
                  widths={imageWidths}
                  sizes={imageSizes}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <video muted loop playsinline preload="metadata">
                  <source src={withBase(m.src)} type="video/mp4" />
                </video>
              )}
            </div>
          ))}

          <button class="slide-nav slide-nav--prev" type="button" aria-label="Previous image">
            <Icon name="chevron-left" />
          </button>
          <button class="slide-nav slide-nav--next" type="button" aria-label="Next image">
            <Icon name="chevron-right" />
          </button>

          <div class="slide-dots" aria-hidden="true">
            {media.map((_, i) => <span class:list={[{ 'is-active': i === 0 }]} />)}
          </div>
        </div>
      ) : first.type === 'image' ? (
        <Image
          src={first.src}
          alt={first.alt ?? altFor(0)}
          widths={imageWidths}
          sizes={imageSizes}
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <video muted loop playsinline preload="metadata">
          <source src={withBase(first.src)} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      )
    }

    <span class="card-badge">
      <Icon name={badge.icon} />
      {badge.text}
    </span>

    <!-- A real link to the project's own page, not a button. With JavaScript it
         is intercepted and opens the modal; without it (and for ctrl/middle
         click, and for crawlers) it navigates to /work/<id>/.

         The title is repeated in an .sr-only span so the anchor text is the
         project name rather than twenty-two identical links reading "View". -->
    <a class="card-open-btn" href={href} data-open>
      <span class="sr-only">{title}</span>
      <span class="card-open" aria-hidden="true">
        View<Icon name="arrow-up-right-from-square" />
      </span>
    </a>

    {
      hasVideo && (
        <button class="sound-btn is-muted" type="button" aria-label="Unmute video">
          <span class="icon-vol-off">
            <Icon name="volume-xmark" />
          </span>
          <span class="icon-vol-on">
            <Icon name="volume-high" />
          </span>
        </button>
      )
    }
  </div>

  <div class="card-body">
    <div class="card-eyebrow">
      <span>{String(index + 1).padStart(2, '0')} / {categoryLabel[category] ?? category}</span>
      <button class="like-btn" type="button" aria-pressed="false" aria-label={`Like ${title}`}>
        <span class="heart-outline"><Icon name="heart" set="regular" /></span>
        <span class="heart-solid"><Icon name="heart" set="solid" /></span>
        <span class="like-count">…</span>
      </button>
    </div>

    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>

    {
      tools.length > 0 && (
        <div class="card-tools">
          {tools.slice(0, 3).map((tool) => (
            <span class="tool-tag">{tool}</span>
          ))}
          {tools.length > 3 && <span class="tool-tag">+{tools.length - 3}</span>}
        </div>
      )
    }
  </div>
</article>

<style>
  /* Clamped so a long description can't make one card twice the height of its
     neighbours — the full text is in the modal. */
  .card-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--ink-muted);
  }
</style>
