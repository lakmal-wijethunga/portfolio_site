---
/**
 * A single reusable dialog, populated by main.ts from the clicked card's
 * `data-*` attributes. One dialog for fourteen projects keeps the HTML small
 * and the focus management in one place.
 */
import Icon from './Icon.astro';
---

<div class="modal" id="project-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-panel">
    <button class="modal-close" type="button" aria-label="Close project details">
      <Icon name="xmark" />
    </button>

    <div class="modal-media" data-modal-media></div>

    <div class="modal-info">
      <p class="modal-eyebrow" data-modal-category></p>
      <h3 class="modal-title" id="modal-title" data-modal-title></h3>
      <p class="modal-description" data-modal-description></p>

      <div class="modal-block" data-modal-tools-block hidden>
        <h4>Tools used</h4>
        <div class="modal-tools" data-modal-tools></div>
      </div>

      <!-- The dialog is a preview; this is the route to the project's own page,
           which carries every frame and is the URL that gets indexed. -->
      <a class="btn btn--solid modal-full-link" data-modal-full href="#">
        View full project<Icon name="arrow-right" />
      </a>

      <div class="modal-links" data-modal-links></div>

      <div class="modal-foot">
        <button class="like-btn" type="button" data-modal-like aria-pressed="false">
          <span class="heart-outline"><Icon name="heart" set="regular" /></span>
          <span class="heart-solid"><Icon name="heart" set="solid" /></span>
          <span class="like-count" data-modal-like-count>…</span>
        </button>
        <span class="mono-label">Esc to close</span>
      </div>
    </div>
  </div>
</div>
