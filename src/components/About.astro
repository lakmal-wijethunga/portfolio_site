---
/**
 * About. Two columns of substance rather than portrait-plus-text: the prose
 * carries the left, the toolkit sits right as a numbered technical index rather
 * than a cloud of pills, so it scans as a capability list.
 */
import Icon from './Icon.astro';
import { withBase } from '../utils/url';
import { site, toolkit } from '../data/site';

const cvUrl = withBase(site.cvFile);
---

<section class="section" id="about">
  <div class="shell">
    <div class="section-head">
      <p class="section-index">01 — About</p>
      <h2>Pushing the boundaries of 3D visualization</h2>
    </div>

    <div class="about-grid">
      <div class="about-body reveal">
        <p class="lede">
          I'm a versatile creative with a strong foundation in 3D visualization, generative AI and
          adjacent digital technologies.
        </p>
        <p>
          Working mainly in Blender and CLO 3D, I bring concepts to life through visually compelling
          animations and simulations. My path blends creativity with engineering — from AI model
          training and object-detection systems through to hands-on IT support in fast-moving,
          real-world environments.
        </p>
        <p>
          Curiosity drives the work. I keep exploring emerging tech to push what's possible in
          digital design and smart systems, whether that means crafting immersive visuals or
          building intelligent solutions. The aim is work that is both impactful and inspiring.
        </p>

        <div class="about-actions">
          <a href={cvUrl} download={site.cvDownloadName} class="btn btn--solid">
            <Icon name="download" />Download CV
          </a>
          <a href="#work" class="btn btn--ghost">See selected work</a>
        </div>
      </div>

      <div class="about-aside reveal">
        <p class="mono-label toolkit-heading">Toolkit &amp; capabilities</p>
        <div class="toolkit">
          {
            toolkit.map((item, i) => (
              <div class="toolkit-item">
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{item}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .toolkit-heading {
    margin-bottom: var(--sp-4);
  }
</style>
