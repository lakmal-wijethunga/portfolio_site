---
/**
 * Inlines a Font Awesome Free SVG at build time — no icon font, no CDN request,
 * no runtime cost. Icons render at 1em and inherit currentColor via `fill`.
 */
interface Props {
  name: string;
  set?: 'solid' | 'regular' | 'brands';
  class?: string;
}

const { name, set = 'solid', class: className } = Astro.props;

// Resolved from the project root rather than import.meta.url: during prerender
// this module executes from inside dist/, where node_modules does not exist.
const { readFileSync } = await import('node:fs');
const { resolve } = await import('node:path');

const svgPath = resolve(
  process.cwd(),
  `node_modules/@fortawesome/fontawesome-free/svgs/${set}/${name}.svg`
);

const svg = readFileSync(svgPath, 'utf-8')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(
    '<svg',
    `<svg class="icon${className ? ` ${className}` : ''}" aria-hidden="true" focusable="false"`
  );
---

<Fragment set:html={svg} />

<style is:global>
  /* Global (not scoped) because icons are also cloned into the modal by
     main.ts, where a scope attribute would not be applied. */
  .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    fill: currentColor;
    flex-shrink: 0;
  }
</style>
