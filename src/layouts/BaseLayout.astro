---
/**
 * The document shell: fonts, SEO, structured data, theme bootstrap and the
 * fixed page chrome (scroll progress + back-to-top).
 *
 * Every SEO field is per-page. The canonical in particular is derived from
 * `Astro.url` rather than hardcoded to the site root — a shared canonical would
 * quietly collapse every project page into the homepage.
 */
import '@fontsource-variable/saira';
import '@fontsource-variable/saira/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import defaultShareImage from '../assets/hero-background.jpg';
import Icon from '../components/Icon.astro';
import { withBase } from '../utils/url';
import { absoluteUrl, personSchema, websiteSchema } from '../utils/seo';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** `article` for a single project, `website` for index pages. */
  ogType?: 'website' | 'article';
  /** Per-page share image. Falls back to the site-wide one. */
  shareImage?: ImageMetadata;
  /** Extra JSON-LD nodes merged into the page's `@graph`. */
  schema?: Record<string, unknown>[];
  /** Skip-link target, since not every page has a #work section. */
  skipTo?: string;
}

const {
  title,
  description,
  ogType = 'website',
  shareImage,
  schema = [],
  skipTo = '#main',
} = Astro.props;

const canonicalURL = absoluteUrl(Astro.url.pathname, Astro.site);

// Width is fixed at 1200 (the widest any scraper renders); height is derived
// from the source so the aspect ratio is never distorted and the width/height
// tags we emit are actually true.
const source = shareImage ?? defaultShareImage;
const shareWidth = 1200;
const shareHeight = Math.round((source.height / source.width) * shareWidth);
const rendered = await getImage({ src: source, width: shareWidth, format: 'jpeg' });
const shareImageURL = new URL(rendered.src, Astro.site).href;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [personSchema(Astro.site), websiteSchema(Astro.site), ...schema],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Resolve the theme before first paint. Inline and synchronous on
         purpose: any deferral here shows a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersLight =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersLight ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <!-- Primary SEO -->
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0b0b0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph (Facebook, LinkedIn) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImageURL} />
    <meta property="og:image:width" content={String(shareWidth)} />
    <meta property="og:image:height" content={String(shareHeight)} />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta property="og:site_name" content={`${site.name} Portfolio`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lakmal_wijeth" />
    <meta name="twitter:creator" content="@lakmal_wijeth" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageURL} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>

  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href={skipTo}>Skip to content</a>

    <slot />

    <button id="to-top" type="button" aria-label="Back to top">
      <Icon name="arrow-up" />
    </button>
  </body>
</html>
