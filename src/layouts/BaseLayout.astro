---
/**
 * The document shell: fonts, SEO, structured data, theme bootstrap and the
 * fixed page chrome (scroll progress + back-to-top).
 */
import '@fontsource-variable/saira';
import '@fontsource-variable/saira/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import heroBackground from '../assets/hero-background.jpg';
import Icon from '../components/Icon.astro';
import { withBase } from '../utils/url';
import { site, socials, toolkit } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonicalURL = new URL(withBase(''), Astro.site);
const ogImage = await getImage({ src: heroBackground, width: 1200, format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: canonicalURL.href,
  email: site.email,
  telephone: site.phoneHref,
  address: {
    '@type': 'PostalAddress',
    addressRegion: site.region,
    addressLocality: 'Mirigama',
    addressCountry: site.country,
  },
  knowsAbout: [...toolkit],
  sameAs: socials.map((s) => s.url),
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Resolve the theme before first paint. Inline and synchronous on
         purpose: any deferral here shows a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersLight =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersLight ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <!-- Primary SEO -->
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b0b0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph (Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta property="og:site_name" content={`${site.name} Portfolio`} />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lakmal_wijeth" />
    <meta name="twitter:creator" content="@lakmal_wijeth" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data: Person -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#work">Skip to work</a>

    <slot />

    <button id="to-top" type="button" aria-label="Back to top">
      <Icon name="arrow-up" />
    </button>
  </body>
</html>
